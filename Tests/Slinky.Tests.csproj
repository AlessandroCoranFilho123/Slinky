<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Exact versions below may have moved on by the time you restore this — if any of these
      fail to resolve, open "Manage NuGet Packages" in Visual Studio for this project and
      update to whatever the current version is; nothing here is version-sensitive.
    -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Linked, not referenced: these files have zero WinRT/XAML dependency by design, so
      they compile in a plain net8.0 test project even though the app targets WinUI 3.
      UI classes remain covered by the app build and the Windows smoke run.
    -->
    <Compile Include="..\Slinky\AppTheme.cs" Link="Linked\AppTheme.cs" />
    <Compile Include="..\Slinky\ThemePalette.cs" Link="Linked\ThemePalette.cs" />
    <Compile Include="..\Slinky\ContrastCalculator.cs" Link="Linked\ContrastCalculator.cs" />
    <Compile Include="..\Slinky\ThemeTabState.cs" Link="Linked\ThemeTabState.cs" />
    <Compile Include="..\Slinky\TextSearch.cs" Link="Linked\TextSearch.cs" />
    <Compile Include="..\Slinky\EditorTapRouting.cs" Link="Linked\EditorTapRouting.cs" />
  </ItemGroup>

</Project>
